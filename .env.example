# Environment variables — copy to `.env` and fill in. NEVER commit `.env`.
#
# Background: credentials used to be hardcoded in source and are therefore in git
# history. Removing them from the code does NOT un-leak them — every value listed
# here as "was committed" must be ROTATED at the provider.

# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------
# Was committed in server/datasources.json and the three
# `server/datasources {am,ob,smp}.json` variants, and in the `todo` file.
# ROTATE THESE — full read/write access to the live trading database.
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/algo

# ---------------------------------------------------------------------------
# Tradelab / Arham OAuth  (server/boot/tradelab_auth.js)
# ---------------------------------------------------------------------------
# The client secret was hardcoded AND executed on every app boot, in all ~150
# strategy processes. ROTATE AT THE BROKER.
# If these are unset the OAuth routes are skipped with a warning; the app still
# boots, so an unused integration cannot block startup.
TRADELAB_CLIENT_ID=
TRADELAB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Still hardcoded — TODO, not yet migrated
# ---------------------------------------------------------------------------
# These remain in source and should move here next. Listed so the work is
# visible rather than forgotten:
#   server/lib/notify.js        Telegram bot token
#   server/lib/s3upload.js      AWS access key / secret
#   server/tools/daily_report.js SendGrid API key
#   server/tools/tradelab_login.js broker credentials
#   common/models/client.js:217 hardcoded weak password used in a reset path
# TELEGRAM_BOT_TOKEN=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# SENDGRID_API_KEY=

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# All market schedules are IST. ecosystem.config.cjs sets this per process.
TZ=Asia/Kolkata
NODE_ENV=production
