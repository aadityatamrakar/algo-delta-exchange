{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "apps/*/src/**/*.ts",
    "apps/*/test/**/*.ts"
  ],
  // apps/web has its own tsconfig (JSX, DOM libs, vite/client types) and is
  // typechecked by `npm run typecheck --workspace @algomaker/web`, which the
  // root `typecheck` script chains — excluded here, NOT unchecked.
  "exclude": ["node_modules", "archive", "apps/web"]
}
