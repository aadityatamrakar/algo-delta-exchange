{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,

    // Node 24 runs .ts directly by STRIPPING types — it cannot emit code for
    // enums, namespaces, parameter properties or decorators. This flag makes tsc
    // reject that syntax at type-check time so we never write something the
    // runtime silently cannot execute. Do not remove it.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,

    // Node's type-stripping runtime resolves the file it is given, so ESM imports
    // must carry the real '.ts' extension. There is no emit step to rewrite them,
    // hence noEmit + allowImportingTsExtensions rather than an output-path rewrite.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}
